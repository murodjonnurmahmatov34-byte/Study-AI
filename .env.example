# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ─── App ─────────────────────────────────────────────────────────────────────
# Public URL used for OAuth redirects and password-reset links
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to "true" to return password reset links in the API response when no
# email provider is configured (development only)
EXPOSE_RESET_LINK=false

# ─── AI provider (server-side only, never exposed to the browser) ────────────
# openai | anthropic | openai-compatible | local
# When AI_API_KEY is empty the app falls back to a local extractive engine.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Optional custom base URL (Groq, Together, Ollama, Azure, etc.)
# AI_BASE_URL=https://api.groq.com/openai/v1

# ─── Google OAuth (optional) ─────────────────────────────────────────────────
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
